{
  "name": "poe2-crafting-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Path of Exile 2 crafting helper: browse bases & modifiers, reference crafting materials, and let the crafting brain pick the cheapest path to the item you want.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "data:refresh": "tsx scripts/refresh-data.ts",
    "data:materials": "tsx scripts/refresh-materials.ts",
    "data:seed": "tsx scripts/seed-db.ts",
    "data:setup": "tsx scripts/refresh-data.ts && tsx scripts/refresh-materials.ts && tsx scripts/seed-db.ts",
    "test": "tsx --require ./scripts/shim-server-only.cjs --test tests/*.test.ts",
    "prepare": "sh -c '[ -n \"$CI\" ] || [ ! -d .git ] || husky'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-config-hints",
    "audit:ci": "sh scripts/npm-audit-ci.sh",
    "check:ai-attribution": "node scripts/check-ai-attribution.mjs",
    "test:ai-attribution": "node --test scripts/check-ai-attribution.test.mjs",
    "test:commitlint": "node --test scripts/commitlint-config.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^20.17.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --no-warn-ignored --max-warnings 0 --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,css,scss,md,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
